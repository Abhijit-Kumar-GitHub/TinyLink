#!/bin/bash
# cloud-init on node 2 ("ops"): k3s agent joining node 1 over the private network.
# Logs: /var/log/cloud-init-output.log
set -euxo pipefail

if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# The agent retries until the server on node 1 is up, so boot order doesn't matter.
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" K3S_TOKEN="${k3s_token}" \
  K3S_URL="https://${server_private_ip}:6443" sh -s - agent \
  --node-label tinylink.io/role=ops \
  --kubelet-arg=fail-swap-on=false
