# Copy to .env (gitignored) and fill in. Use SINGLE quotes: the password hash contains '$',
# which docker compose would otherwise try to interpolate.
SA_PASSWORD='ChangeMe!Strong1'
API_KEY='change-me'
OPERATOR_USERNAME='operator'
# Generate: dotnet run --project src/OperatorConsole -- hash-password '<password>'
OPERATOR_PASSWORD_HASH='PBKDF2-SHA256$210000$...$...'

# Image naming: <REGISTRY>/tinylink-<service>:<TAG>
REGISTRY=farspawn
TAG=dev
