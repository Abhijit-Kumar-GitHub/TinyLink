    {
      "id": 19,
      "type": "table",
      "title": "Top links (from vw_LinkClickSummary)",
      "datasource": {
        "type": "mssql",
        "uid": "tinylink-sql"
      },
      "description": "Queried live from the SQL Server view, not Prometheus: per-link series would be unbounded.",
      "gridPos": {
        "x": 16,
        "y": 38,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "tinylink-sql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP 10 Code, TotalClicks AS [Total], ClicksLast24h AS [Last 24h], LastClickedAtUtc AS [Last click (UTC)] FROM dbo.vw_LinkClickSummary ORDER BY TotalClicks DESC"
        }
      ]
